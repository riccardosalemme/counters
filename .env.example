SECRET_KEY="django-insecure-default-change-this-in-production"
DEBUG=true
ALLOWED_HOSTS="localhost,127.0.0.1"
CSRF_TRUSTED_ORIGINS=""
TIME_ZONE="Europe/Rome"

# Per PostgreSQL 
# DATABASE_URL="postgres://user:password@localhost:5432/counters"
# Per SQLite
DATABASE_URL="sqlite:///db.sqlite3"

# Se impostato su "true", una scrittura (add/subtract/set) su uno slug non esistente
# creerà automaticamente un nuovo contatore (rispondendo con HTTP 201).
COUNTERS_AUTOCREATE=true

SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0